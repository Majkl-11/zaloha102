<h1>Objednávka vizitek</h1>
    <form id="businessCardForm">
        <div class="form-group">
            <label for="quantity">Počet vizitek:</label>
            <input type="number" id="quantity" name="quantity" placeholder="Zadejte počet vizitek" required>
        </div>

        <div class="form-group">
            <label for="paperType">Druh papíru:</label>
            <select id="paperType" name="paperType" required>
                <option value="matny">Matný</option>
                <option value="leskly">Lesklý</option>
            </select>
        </div>

        <div class="form-group">
            <label for="printType">Tisk:</label>
            <select id="printType" name="printType" required>
                <option value="jednostranny">Jednostranný tisk</option>
                <option value="oboustranny">Oboustranný tisk</option>
            </select>
        </div>

        <div class="form-group">
            <label for="dimension">Rozměr:</label>
            <select id="dimension" name="dimension" required>
                <option value="90x50">90 x 50 mm</option>
                <option value="85x55">85 x 55 mm</option>
                <option value="90x60">90 x 60 mm</option>
            </select>
        </div>

        <div class="price">
            Cena: <span id="price">0 Kč</span>
        </div>

        <button type="submit" class="btn">Objednat</button>
    </form>