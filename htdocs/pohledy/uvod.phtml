  }

  /* Styl pro slideshow */
.swiper-container {
  width: 100%;
  height: 400px; /* Výška je nastavena na menší hodnotu, např. 400px */
  margin: 0;
  position: relative;
}

.swiper-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Obrázek se přizpůsobí, ale zachová si proporce */
}

/* Nastavení pozice teček */
.swiper-pagination {
  left: 50%; transform: translateX(-50%);
  position: absolute;
  bottom: 10px; /* Tečky blíže spodní části obrázku */
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
}

/* Nastavení pro šipky */
.swiper-button-next, .swiper-button-prev {
  position: absolute;
  top: 50%; /* Šipky na střed */
  transform: translateY(-50%);
  color: white; /* Bílé šipky */
  z-index: 10;
}

.swiper-button-next {
  right: 10px; /* Šipka na pravý okraj */
}

.swiper-button-prev {
  left: 10px; /* Šipka na levý okraj */
}

</style>

<!-- Slideshow sekce -->
