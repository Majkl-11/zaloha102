<script>
  // Inicializace Swiper.js
  var swiper = new Swiper('.swiper-container', {
    loop: true, // Smyčka
    autoplay: {
      delay: 3000, // Automatické přepínání každé 3 sekundy
      disableOnInteraction: false, // Po ručním přepnutí pokračuje autoplay
    },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true, // Možnost kliknout na tečky a změnit slide
    },
  });
</script>
